{
  "name": "modkit-plugin",
  "version": "0.2.0",
  "private": true,
  "description": "The modkit Obsidian plugin: point at something, describe the change, get a patch.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -b tsconfig.test.json",
    "test": "npm run build && tsc -b tsconfig.test.json && node test/build-tests.mjs && node --test test/*.test.mjs",
    "clean": "rm -rf dist .tsbuild test/build"
  },
  "dependencies": {
    "@modkit/types": "^0.1.0",
    "@noble/ed25519": "2.3.0",
    "monkey-around": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "UNLICENSED"
}
